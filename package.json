{
  "name": "typedpost",
  "version": "0.1.0",
  "description": "One typed TypeScript API for sending Node.js email with Resend, Brevo, or SMTP.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./testing": { "types": "./dist/testing.d.ts", "import": "./dist/testing.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "assets/typedpost-mark.svg", "README.md", "LICENSE", "SECURITY.md", "CODE_OF_CONDUCT.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": { "zod": "^4.6.5" },
  "peerDependencies": {
    "@getbrevo/brevo": ">=6 <7",
    "nodemailer": ">=7 <11",
    "resend": ">=6 <7"
  },
  "peerDependenciesMeta": {
    "@getbrevo/brevo": { "optional": true },
    "nodemailer": { "optional": true },
    "resend": { "optional": true }
  },
  "devDependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "nodemailer": "^10.0.12",
    "resend": "^6.30.0",
    "typescript": "^5.9.2"
  },
  "repository": { "type": "git", "url": "https://github.com/erolsenol/typedpost.git" },
  "bugs": { "url": "https://github.com/erolsenol/typedpost/issues" },
  "homepage": "https://github.com/erolsenol/typedpost#readme",
  "keywords": ["email", "mail", "nodejs", "typescript", "transactional-email", "email-sending", "resend", "brevo", "smtp"]
}
